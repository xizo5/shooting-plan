# 复制本文件为 .env 并填入自己的 Key。
# .env 已被 .gitignore 忽略，绝不会提交到仓库。
#
# 说明：这些值只是「首次打开的默认值」。在设置页改过的配置存在浏览器里，
# 优先级高于这里——所以遇到 CORS 要换中转地址时，直接改设置页即可，无需重新构建。

# ── 主模型（必填）──────────────────────────────
# OpenAI 兼容接口，常见厂商：
#   DeepSeek    https://api.deepseek.com
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi        https://api.moonshot.cn/v1
VITE_BASE_URL=https://api.deepseek.com
VITE_API_KEY=sk-在这里填你的Key
# 需要支持「看图」才能用参考图（图生图）：智谱 glm-4v-flash / 通义 qwen-vl 系列
VITE_MODEL=deepseek-v4-flash

# ── 参考片生成（可选，留空则不启用）──────────────
# 默认豆包 Seedream：https://ark.cn-beijing.volces.com/api/v3
VITE_IMAGE_BASE_URL=
VITE_IMAGE_API_KEY=
VITE_IMAGE_MODEL=doubao-seedream-4-0-250828
# 尺寸留空由模型自适应；智谱 GLM-Image 用 1056x1568
VITE_IMAGE_SIZE=
